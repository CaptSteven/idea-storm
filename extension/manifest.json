{
  "manifest_version": 3,
  "name": "SOPFlow Recorder",
  "description": "Record browser operations, redact sensitive fields, and turn them into editable SOP documents.",
  "version": "0.2.0",
  "minimum_chrome_version": "109",
  "action": {
    "default_title": "SOPFlow",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage", "tabs", "unlimitedStorage"],
  "host_permissions": ["<all_urls>", "http://127.0.0.1/*", "http://localhost/*"]
}
